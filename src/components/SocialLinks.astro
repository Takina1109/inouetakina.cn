---
import { socials } from '@/data/site';
import { getBrandIcon } from '@/lib/icons';
---

<nav class="socials" aria-label="我的主页">
  {
    socials.map((social) => {
      const icon = getBrandIcon(social.icon);
      return (
        <a
          class="socials__link"
          href={social.url}
          target="_blank"
          rel="noopener noreferrer me"
          data-label={social.label}
          aria-label={social.label}
          style={social.color ? `--brand:${social.color}` : undefined}
        >
          <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
            <path d={icon.path} />
          </svg>
        </a>
      );
    })
  }
</nav>
