---
/**
 * 侧边栏「站点信息」面板
 * 显示：建站时间 / 文章总数 / 总字数 / 最后更新时间
 * 数据由 src/lib/posts.ts 的 buildStats() 在构建时算好。
 */
import { site } from '@/data/site';
import { formatDate, parseLocalDate, type SiteStats } from '@/lib/posts';

interface Props {
  stats: SiteStats;
}

const { stats } = Astro.props;

const launched = parseLocalDate(site.launched);
/* 建站当天算第 1 天 */
const days = Math.max(1, Math.floor((Date.now() - launched.getTime()) / 86_400_000) + 1);

const number = new Intl.NumberFormat('zh-CN');
---

<div class="card stats">
  <dl class="stats__list">
    <div class="stats__row">
      <dt class="stats__label">建站时间</dt>
      <dd class="stats__value">
        <time datetime={formatDate(launched)}>{formatDate(launched)}</time>
        <span class="stats__sub">已运行 {number.format(days)} 天</span>
      </dd>
    </div>

    <div class="stats__row">
      <dt class="stats__label">文章总数</dt>
      <dd class="stats__value stats__value--strong">
        {number.format(stats.total)} 篇
        {
          stats.total > 0 && (
            <span class="stats__sub">
              文章 {stats.articles} · 动态 {stats.thoughts}
            </span>
          )
        }
      </dd>
    </div>

    <div class="stats__row">
      <dt class="stats__label">总字数</dt>
      <dd class="stats__value">
        {number.format(stats.words)} 字
      </dd>
    </div>

    <div class="stats__row">
      <dt class="stats__label">最后更新</dt>
      <dd class="stats__value">
        {stats.updated ? <time datetime={formatDate(stats.updated)}>{formatDate(stats.updated)}</time> : '—'}
      </dd>
    </div>
  </dl>
</div>
