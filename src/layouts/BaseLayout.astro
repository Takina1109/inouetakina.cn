---
import '@/styles/global.css';
import { site } from '@/data/site';
import { buildHeatmap, buildSearchIndex, buildStats, getPosts } from '@/lib/posts';
import SearchDialog from '@/components/SearchDialog.tsx';
import Sidebar from '@/components/Sidebar.astro';

interface Props {
  /** 页面标题，会自动拼接站点名 */
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
/*
 * 浏览器标签页上的标题：就是页面自己的名字，不再拼站点名。
 * 首页不传 title，所以显示的是 src/data/site.ts 里的 title。
 *
 * 想恢复「页面名 · 站点名」的形式，把下面这行换成：
 *   const pageTitle = title ? `${title} · ${site.title}` : site.title;
 */
const pageTitle = title || site.title;

/* 全站共享数据：内容列表 / 搜索索引 / 热力图 / 站点统计 */
const posts = await getPosts();
const heatmap = buildHeatmap(posts);
const searchIndex = buildSearchIndex(posts);
const stats = buildStats(posts);

/* 当前路径，用来给导航按钮打高亮 */
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

/* 顶部主导航：主页 / 文章 / 动态 / 推荐。
   标签的入口不在这里 —— 全部标签在搜索弹窗里（点搜索展开），
   标签总览页 /tags/ 的入口在页脚的「全部标签」文字链接。 */
const navIcons = {
  home: 'M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z',
  post: 'M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m-5 14H7v-2h7zm3-4H7v-2h10zm0-4H7V7h10z',
  thought: 'M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z',
  pick: 'M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z',
} as const;

const navItems = [
  { href: '/', label: '主页', icon: navIcons.home },
  { href: '/posts/', label: '文章', icon: navIcons.post },
  { href: '/thoughts/', label: '动态', icon: navIcons.thought },
  { href: '/recommend/', label: '推荐', icon: navIcons.pick },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a0a" />
  </head>

  <body>
    <!-- 落樱装饰 -->
    <div class="petals" aria-hidden="true">
      {
        Array.from({ length: 9 }).map((_, i) => (
          <span
            style={`left:${(i * 11 + 4) % 100}%; animation-duration:${13 + (i % 5) * 3}s; animation-delay:${i * 1.6}s; width:${
              8 + (i % 3) * 3
            }px; height:${8 + (i % 3) * 3}px;`}
          />
        ))
      }
    </div>

    <div class="app">
      <!-- 顶栏：横跨整页宽度，滚动时吸附在顶部 -->
      <div class="topbar">
        <!--
          窄屏（≤900px）才显示：把左侧边栏收成一个抽屉，点这里开。
          宽屏下侧边栏是常驻的一列，这个按钮 display: none。
          状态由页面底部的脚本维护（aria-expanded / body.drawer-open）。
        -->
        <button
          class="icon-btn sidebar-toggle"
          type="button"
          aria-label="打开侧边栏"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
          </svg>
        </button>

        <nav class="topnav" aria-label="主导航">
          {
            navItems.map((item) => (
              <a
                class="nav-btn"
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                title={item.label}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={item.icon} />
                </svg>
                <span class="nav-btn__text">{item.label}</span>
              </a>
            ))
          }
        </nav>

        <span class="topbar__spacer"></span>

        <!--
          RSS 入口在页脚（右下角那个「RSS」文字链接），
          顶栏不再放图标按钮。
        -->
        <SearchDialog client:load items={searchIndex} />
      </div>

      <!--
        大标题区：同样用 grid-column: 1 / -1 横跨整页，
        所以标题会比正文更靠左（向左延伸），同时把左侧边栏整体推到下面。
        页面用 <Fragment slot="hero"> 传入自己的标题。
      -->
      {
        Astro.slots.has('hero') && (
          <div class="page-hero">
            <slot name="hero" />
          </div>
        )
      }

      <Sidebar heatmap={heatmap} stats={stats} />

      <main class="main">
        <slot />

        <footer class="site-footer">
          <span>© {site.since}–{new Date().getFullYear()} {site.author}</span>
          <span>用 Astro 构建 · 内容用 Markdown 书写</span>
          <a href="/rss.xml">RSS</a>
          <a href="/tags/">全部标签</a>
        </footer>
      </main>
    </div>

    <!-- 窄屏抽屉打开时的遮罩：点它关闭侧边栏。只在 body.drawer-open 时可见 -->
    <div class="sidebar-scrim" aria-hidden="true"></div>

    <script is:inline>
      /*
       * 窄屏下把左侧边栏变成抽屉。
       * 宽屏（> 900px）时侧边栏本来就在，这个脚本什么也不做。
       *
       * 抽屉关着的时候给它加 inert：元素虽然被移出画面（visibility: hidden
       * 已经不参与 Tab 了），再叠一层 inert 更保险。宽屏下绝对不能加，
       * 否则整条侧边栏会被当成不可交互。
       */
      (function () {
        var btn = document.querySelector('.sidebar-toggle');
        var panel = document.getElementById('sidebar');
        var scrim = document.querySelector('.sidebar-scrim');
        if (!btn || !panel || !scrim) return;

        // 这个断点要和 global.css 里那个保持一致
        var narrow = window.matchMedia('(max-width: 900px)');
        var open = false;

        function apply() {
          var isDrawer = narrow.matches;
          var shown = isDrawer && open;

          document.body.classList.toggle('drawer-open', shown);
          btn.setAttribute('aria-expanded', String(shown));
          btn.setAttribute('aria-label', shown ? '关闭侧边栏' : '打开侧边栏');
          panel.inert = isDrawer && !open;

          // 抽屉开着时锁住页面滚动，不然底下的正文会跟着一起滑
          document.body.style.overflow = shown ? 'hidden' : '';
        }

        function set(next) {
          if (next === open) return;
          open = next;
          apply();
        }

        btn.addEventListener('click', function () {
          set(!open);
        });

        scrim.addEventListener('click', function () {
          set(false);
        });

        // 抽屉里的关闭按钮（宽屏下它是隐藏的）
        var closeBtn = panel.querySelector('[data-sidebar-close]');
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            set(false);
          });
        }

        // Esc 关闭，并把焦点还给开关按钮（否则焦点会停在看不见的地方）
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && open) {
            set(false);
            btn.focus();
          }
        });

        // 拖窗口跨过断点时直接复位，免得状态卡住
        narrow.addEventListener('change', function () {
          set(false);
          apply();
        });

        apply();
      })();
    </script>
  </body>
</html>
