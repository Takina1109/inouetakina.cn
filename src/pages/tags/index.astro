---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, getTagCounts } from '@/lib/posts';

const posts = await getPosts();
const tags = getTagCounts(posts);
---

<BaseLayout title="栞" description="按标签浏览全部文章">
  <Fragment slot="hero">
    <header class="page-head">
      <p class="page-head__eyebrow">Tags</p>
      <h1 class="page-head__title">全部标签</h1>
      <p class="page-head__desc">共 {tags.length} 个标签，点击查看对应文章。</p>
    </header>
  </Fragment>

  <ul class="tag-cloud">
    {
      tags.map(({ tag, count }) => (
        <li>
          <a class="tag-cloud__item" href={`/tags/${encodeURIComponent(tag)}/`}>
            <span class="tag-cloud__name">#{tag}</span>
            <span class="tag-cloud__count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {tags.length === 0 && <p class="empty-state">还没有任何标签，给文章加上 tags 试试。</p>}
</BaseLayout>
